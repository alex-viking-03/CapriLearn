<UserControl x:Class="CapriFrontendNew.Views.Authentication.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#10131F">

        <Border Margin="64,80"
                Padding="28"
                Background="#1D2337"
                CornerRadius="12"
                BorderBrush="#303A56"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Войти в Capri"
                               Foreground="#F3F3FF"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Используй почту и пароль своего аккаунта."
                               Foreground="#AFB7D1"
                               FontSize="13"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Поля -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Почта"
                               Foreground="#F3F3FF"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,7"/>

                    <Border Background="#10131F"
                            BorderBrush="#303A56"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">

                        <TextBox x:Name="EmailTB"
                            Background="Transparent"
                            Foreground="#F3F3FF"
                            CaretBrush="#D5FF62"
                            BorderThickness="0"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Пароль"
                               Foreground="#F3F3FF"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,15,0,7"/>

                    <Border Background="#10131F"
                            BorderBrush="#303A56"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10">

                        <PasswordBox x:Name="PasswordPB"
                            Background="Transparent"
                            Foreground="#F3F3FF"
                            CaretBrush="#D5FF62"
                            BorderThickness="0"
                            FontSize="14"/>
                    </Border>

                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                            Margin="0,15,0,0">

                    <Button Content="Войти →"
                            Style="{StaticResource PrimaryButton}"
                            Click="EnterButton_Click"/>

                    <Button Content="Ещё нет аккаунта? Зарегистрироваться"
                            Style="{StaticResource LinkButton}"
                            Margin="0,15,0,0"
                            Click="RegisterButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
