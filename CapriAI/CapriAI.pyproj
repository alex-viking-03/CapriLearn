<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>5c54cbc3-fcae-491b-96bd-ea59c7674dca</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>CapriAI.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>CapriAI</Name>
    <RootNamespace>CapriAI</RootNamespace>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CapriAI.py" />
    <Compile Include="Controllers\AdminController.py" />
    <Compile Include="Controllers\CapriController.py" />
    <Compile Include="Controllers\CourseController.py" />
    <Compile Include="Controllers\TaskController.py" />
    <Compile Include="Controllers\TaskTestCaseController.py" />
    <Compile Include="Controllers\UserController.py" />
    <Compile Include="Database.py" />
    <Compile Include="DTOs\CapriEvent.py" />
    <Compile Include="DTOs\CourseDTO.py" />
    <Compile Include="DTOs\TaskDTO.py" />
    <Compile Include="DTOs\TaskTestCaseDTO.py" />
    <Compile Include="DTOs\UserDTO.py" />
    <Compile Include="Enums\CapriEventType.py" />
