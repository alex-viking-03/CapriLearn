    <Compile Include="Enums\ProgrammingLanguages.py" />
    <Compile Include="Enums\UserRole.py" />
    <Compile Include="Example.py" />
    <Compile Include="init_db.py" />
    <Compile Include="main.py" />
    <Compile Include="Models\Course.py" />
    <Compile Include="Models\Task.py" />
    <Compile Include="Models\TaskTestCase.py" />
    <Compile Include="Models\User.py" />
    <Compile Include="Security\PasswordHasher.py" />
    <Compile Include="Services\AdminService.py" />
    <Compile Include="Services\CourseService.py" />
    <Compile Include="Services\TaskService.py" />
    <Compile Include="Services\TaskTestCaseService.py" />
    <Compile Include="Services\UserService.py" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Version>3.13</Version>
      <Description>.venv (Python 3.13 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="DTOs\" />
    <Folder Include="Models\" />
    <Folder Include="Enums\" />
    <Folder Include="Controllers\" />
    <Folder Include="CapriFrontend\" />
    <Folder Include="Security\" />
    <Folder Include="Services\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CapriFrontend\index.html" />
    <Content Include="Services\__init__.py" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
